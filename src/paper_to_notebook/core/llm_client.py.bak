"""LLM client with support for Gemini and Azure OpenAI."""
from __future__ import annotations

os_import = False
try:
    import os
    os_import = True
except ImportError:
    pass

import json
import time
from typing import Callable, Optional, Any

from google import genai
from google.genai import types
from openai import AzureOpenAI

from ..config import MAX_RETRIES, RETRY_DELAYS


def _get_api_key(api_key: str | None = None) -> str:
    key = api_key or os.environ.get("GOOGLE_API_KEY") or os.environ.get("GEMINI_API_KEY")
    if not key:
        raise ValueError("Gemini API key not found. Please set GOOGLE_API_KEY in .env")
    return key


def call_gemini(
    system_prompt: str,
    user_content: list,
    max_tokens: int = 8192,
    model: str = "gemini-2.5-pro",
    api_key: str | None = None,
    on_thinking: Optional[Callable[[str], None]] = None,
) -> str:
    """Make a Gemini API call."""
    client = genai.Client(api_key=_get_api_key(api_key))
    config = types.GenerateContentConfig(
        system_instruction=system_prompt,
        max_output_tokens=max_tokens,
        temperature=0.7,
    )

    if on_thinking:
        full_text = ""
        for chunk in client.models.generate_content_stream(
            model=model, contents=user_content, config=config
        ):
            try:
                if chunk.candidates and chunk.candidates[0].content and chunk.candidates[0].content.parts:
                    for part in chunk.candidates[0].content.parts:
                        if getattr(part, 'thought', False):
                            if part.text:
                                on_thinking(part.text)
                        else:
                            if part.text:
                                full_text += part.text
            except (AttributeError, IndexError):
                if hasattr(chunk, 'text') and chunk.text:
                    full_text += chunk.text
        return full_text
    else:
        response = client.models.generate_content(
            model=model, contents=user_content, config=config
        )
        return response.text


def call_azure_openai(
    system_prompt: str,
    user_content: list,
    max_tokens: int = 4096,
    model: str | None = None,
) -> str:
    """Make an Azure OpenAI API call."""
    client = AzureOpenAI(
        api_key=os.environ.get("AZURE_OPENAI_API_KEY"),
        api_version=os.environ.get("AZURE_OPENAI_API_VERSION"),
        azure_endpoint=os.environ.get("AZURE_OPENAI_ENDPOINT")
    )
    
    deployment_name = model or os.environ.get("AZURE_OPENAI_DEPLOYMENT_NAME", "gpt-4o")
    
    # Process user_content for OpenAI format
    messages = [{"role": "system", "content": system_prompt}]
    
    # If there's a PDF part, we might need vision or text extraction fallback
    # Azure OpenAI GPT-4o supports vision but PDF part needs proper handling
    # For now, we assume text or simple content if PDF handling is complex
    # Simplified handling for Azure:
    prompt_text = ""
    for part in user_content:
        if hasattr(part, 'text') and part.text:
            prompt_text += part.text
        elif isinstance(part, str):
            prompt_text += part
        else:
            # Fallback for complex parts (like PDF bytes)
            # Ideal: Use Azure document intelligence or extract text before calling Azure
            prompt_text += "\n[Content from binary source provided]"

    messages.append({"role": "user", "content": prompt_text})
    
    response = client.chat.completions.create(
        model=deployment_name,
        messages=messages,
        max_tokens=max_tokens,
        temperature=0.7
    )
    return response.choices[0].message.content


def call_llm(
    system_prompt: str,
    user_content: list,
    max_tokens: int = 8192,
    model: str | None = None,
    api_key: str | None = None,
    on_thinking: Optional[Callable[[str], None]] = None,
    provider: str | None = None,
) -> str:
    """Generic LLM call router."""
    provider = provider or os.environ.get("LLM_PROVIDER", "gemini").lower()
    
    if provider == "azure":
        return call_azure_openai(system_prompt, user_content, max_tokens, model)
    else:
        return call_gemini(system_prompt, user_content, max_tokens, model or "gemini-2.5-pro", api_key, on_thinking)


def call_llm_with_retry(
    system_prompt: str,
    user_content: list,
    max_tokens: int = 8192,
    model: str | None = None,
    api_key: str | None = None,
    on_thinking: Optional[Callable[[str], None]] = None,
    provider: str | None = None,
) -> str:
    """Call LLM with retry logic."""
    last_error = None

    for attempt in range(MAX_RETRIES):
        try:
            return call_llm(system_prompt, user_content, max_tokens, model, api_key, on_thinking, provider)

        except Exception as e:
            error_str = str(e).lower()
            if any(keyword in error_str for keyword in ["429", "rate", "500", "503", "overloaded", "unavailable"]):
                last_error = e
                wait = RETRY_DELAYS[min(attempt, len(RETRY_DELAYS) - 1)]
                print(f"  Transient error. Waiting {wait}s before retry {attempt+1}/{MAX_RETRIES}...")
                time.sleep(wait)
            else:
                raise

    raise RuntimeError(f"Failed after {MAX_RETRIES} retries. Last error: {last_error}")


def parse_llm_json(raw_text: str, step_name: str, model: str | None = None, api_key: str | None = None, provider: str | None = None) -> dict | list:
    """Parse JSON from LLM response."""
    text = raw_text.strip()

    if text.startswith("```"):
        try:
            first_newline = text.index("\n")
            text = text[first_newline + 1:]
        except ValueError:
            pass
    if text.endswith("```"):
        text = text[:-3]
    text = text.strip()

    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        print(f"  Warning: JSON parse failed in {step_name}. Attempting repair...")
        repair_prompt = (
            f"The following text was supposed to be valid JSON but has a syntax error:\n\n"
            f"{text[:4000]}\n\n"
            f"Error: {e}\n\n"
            f"Return ONLY the corrected valid JSON, nothing else."
        )
        repaired = call_llm_with_retry(
            system_prompt="You are a JSON repair tool. Return only valid JSON.",
            user_content=[repair_prompt],
            max_tokens=max(len(text) // 2, 4096),
            model=model,
            api_key=api_key,
            provider=provider
        )
        repaired = repaired.strip()
        if repaired.startswith("```"):
            repaired = repaired.split("\n", 1)[1]
        if repaired.endswith("```"):
            repaired = repaired[:-3]
        return json.loads(repaired.strip())
